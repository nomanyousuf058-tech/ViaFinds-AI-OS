# ============================================================

# VIAFINDS AI OS — MASTER ENVIRONMENT CONFIGURATION

# ============================================================

#

# IMPORTANT:

# 1. This file is a STRUCTURE/template.

# 2. Empty values are intentional.

# 3. Never commit real secrets.

# 4. Keep private API keys server-side.

# 5. Do NOT use NEXT_PUBLIC_ for private API keys.

# 6. Provider availability/free limits change over time.

# 7. ENABLE_* flags allow the AI router to skip unavailable

# providers without breaking the automation system.

#

# Copy this file to:

#

# .env.local

#

# Then add your real credentials.

#

# ============================================================

# ============================================================

# 00 — APPLICATION

# ============================================================

NODE_ENV=your_value_here

NEXT_PUBLIC_SITE_URL=your_value_here
NEXT_PUBLIC_PRODUCTION_URL=your_value_here

APP_NAME=your_value_here
APP_ENV=your_value_here
APP_REGION=your_value_here

LOG_LEVEL=your_value_here

ENABLE_AUTOMATION=your_value_here
ENABLE_AI_AUTOMATION=your_value_here
ENABLE_SOCIAL_AUTOMATION=your_value_here
ENABLE_CONTENT_AUTOMATION=your_value_here
ENABLE_TREND_AUTOMATION=your_value_here

# ============================================================

# 01 � DATABASE

# ============================================================

# ViaFinds uses Supabase PostgreSQL as the primary database.
# The application connects via the standard PostgreSQL wire protocol
# using the pg client. Do NOT use the Supabase client-only anon key
# for server-side database access.

# Preferred: single connection string.
# DATABASE_URL=postgresql://postgres:[DB_PASSWORD]@db.epljeldqqpwencthcpfj.supabase.co:5432/postgres

# Alternative: individual connection parameters.
POSTGRES_HOST=db.epljeldqqpwencthcpfj.supabase.co
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=[DB_PASSWORD]

# Enable TLS for remote database connections (recommended for Supabase).
DATABASE_SSL=true

# ============================================================

# 02 — REDIS / CACHE

# ============================================================

REDIS_URL=your_value_here
REDIS_HOST=your_value_here
REDIS_PORT=your_value_here
REDIS_USERNAME=your_value_here
REDIS_PASSWORD=your_value_here

REDIS_TLS=your_value_here

